# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
*.tsbuildinfo

# Turborepo
.turbo/

# Test / coverage
coverage/
.nyc_output/

# Caches
.cache/
.eslintcache
.oxlintcache

# Environment
.env
.env.*
!.env.example

# Secret store (raw 32-byte master key + the encrypted name→box map). Written
# wherever config resolves STATE_DIR, so a stray in-repo copy appears when a
# test or manual run points STATE_DIR at a package dir. NEVER committed.
.secrets/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editors / OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.claude

# Internals
.config/

# Runtime home dir (installed add-ons, sessions, sqlite) lives at ~/.basalt/.
# It is NOT part of the repo — managed at runtime by the storage/config
# packages. Listed here only to catch an accidental in-repo copy.
.basalt/

# RULER eval datasets + the cloned RULER source, produced by
# `scripts/generate-ruler-data.sh`. The generated .jsonl embeds third-party
# corpora (Paul Graham essays, SQuAD, HotpotQA), so it is REGENERATED, never
# committed. See packages/evals/README (RULER data) and the script header.
.ruler-data/
.ruler-src/

